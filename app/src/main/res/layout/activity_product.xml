<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:id="@+id/scrollViewMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:paddingHorizontal="20dp">

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="serif"
                    android:text="Tine Cosmetic"
                    android:textColor="@color/primary"
                    android:textSize="22sp"
                    android:textStyle="bold|italic" />

                <ImageButton
                    android:id="@+id/btnProfile"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_circle_avatar"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="@color/primary" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="24dp">

                <TextView
                    android:id="@+id/tvCollectionTitle"
                    style="@style/TitleTextStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="Tine Collection" />

                <TextView
                    android:id="@+id/tvCollectionDesc"
                    style="@style/BodyTextStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Discover our exclusive range of premium skincare and makeup products, designed to enhance your natural radiant beauty." />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvChipAll"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_active"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:text="All"
                        android:textColor="#D9F0D7"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvChipSkincare"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:text="Skincare"
                        android:textColor="@color/primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvChipMakeup"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:text="Makeup"
                        android:textColor="@color/primary"
                        android:textSize="12sp" />


                </LinearLayout>
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="12dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                tools:listitem="@layout/activity_item_product"
                tools:itemCount="4" />

            <TextView
                android:id="@+id/btnLoadMore"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_outline_sage"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="32dp"
                android:text="Load More"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        android:background="@color/background"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <LinearLayout
            android:id="@+id/navHome"
            style="@style/BottomNavItem"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            <ImageView style="@style/BottomNavIcon" android:src="@android:drawable/ic_menu_mylocation" app:tint="@color/text_secondary" />
            <TextView style="@style/BottomNavText" android:text="Home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navShop"
            style="@style/BottomNavItem"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            <View android:layout_width="4dp" android:layout_height="4dp" android:layout_marginBottom="2dp" android:background="@drawable/bg_dot_primary"/>
            <ImageView style="@style/BottomNavIcon" android:src="@android:drawable/ic_menu_info_details" app:tint="@color/primary" />
            <TextView style="@style/BottomNavText" android:text="Shop" android:textColor="@color/primary" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCart"
            style="@style/BottomNavItem"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            <ImageView style="@style/BottomNavIcon" android:src="@drawable/cart" app:tint="@color/text_secondary" />
            <TextView style="@style/BottomNavText" android:text="Cart" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            style="@style/BottomNavItem"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            <ImageView style="@style/BottomNavIcon" android:src="@android:drawable/ic_menu_compass" app:tint="@color/text_secondary" />
            <TextView style="@style/BottomNavText" android:text="Profile" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>