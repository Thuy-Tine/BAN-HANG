<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========================= -->
    <!-- BUTTON PRIMARY -->
    <!-- ========================= -->

    <style name="PrimaryButtonStyle"
        parent="Widget.Material3.Button">

        <item name="backgroundTint">@color/primary</item>

        <item name="android:textColor">@color/white</item>

        <item name="cornerRadius">
            @dimen/radius_medium
        </item>

        <item name="android:textAllCaps">false</item>

    </style>

    <!-- ========================= -->
    <!-- OUTLINE BUTTON -->
    <!-- ========================= -->

    <style name="OutlineButtonStyle"
        parent="Widget.Material3.Button.OutlinedButton">

        <item name="strokeColor">@color/primary</item>

        <item name="android:textColor">@color/primary</item>

        <item name="cornerRadius">
            @dimen/radius_medium
        </item>

        <item name="android:textAllCaps">false</item>

    </style>

    <!-- ========================= -->
    <!-- CARD -->
    <!-- ========================= -->

    <style name="MyCardStyle"
        parent="Widget.Material3.CardView.Elevated">

        <item name="cardCornerRadius">
            @dimen/radius_large
        </item>

        <item name="cardElevation">
            @dimen/card_elevation
        </item>

        <item name="cardBackgroundColor">
            @color/card_background
        </item>

    </style>

    <!-- ========================= -->
    <!-- TEXT TITLE -->
    <!-- ========================= -->

    <style name="TitleTextStyle">

        <item name="android:textColor">
            @color/text_primary
        </item>

        <item name="android:textStyle">bold</item>

        <item name="android:textSize">22sp</item>

    </style>

    <!-- ========================= -->
    <!-- BODY TEXT -->
    <!-- ========================= -->

    <style name="BodyTextStyle">

        <item name="android:textColor">
            @color/text_secondary
        </item>

        <item name="android:textSize">16sp</item>

    </style>

</resources>