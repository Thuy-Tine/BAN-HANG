<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.BANHANG"
        parent="Theme.Material3.Light.NoActionBar">

        <!-- PRIMARY -->
        <item name="colorPrimary">@color/primary</item>

        <item name="colorPrimaryContainer">
            @color/primary_light
        </item>

        <!-- BACKGROUND -->
        <item name="android:windowBackground">
            @color/background
        </item>

        <!-- STATUS BAR -->
        <item name="android:statusBarColor">
            @color/background
        </item>

        <!-- NAVIGATION BAR -->
        <item name="android:navigationBarColor">
            @color/background
        </item>

        <!-- TEXT -->
        <item name="android:textColor">
            @color/text_primary
        </item>

        <!-- BUTTON -->
        <item name="materialButtonStyle">
            @style/PrimaryButtonStyle
        </item>

        <!-- CARD -->
        <item name="cardViewStyle">
            @style/MyCardStyle
        </item>

    </style>

    <style name="BottomNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="BottomNavIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
    </style>

    <style name="BottomNavText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#747871</item>
    </style>

</resources>